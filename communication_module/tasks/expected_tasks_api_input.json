// This file contains the expected JSON format for the tasks that are to be performed by the communication module (tasks api).
// Optional fields are removed if not needed and will be interpreted as their default values.
// Required fields cannot be removed and will result in an error response if not provided.
// Not providing the specific values for the fields will result in an error response.
// Syntax: "key": "example value" // (type) (optional or required) (possible values) (default value), "description", "notes" ...

{
    "other_data": "other_data", // (any) (optional) (any) (default: None), "other data that will not be used by the communication module"

    "list_all_tasks": false, // (bool) (optional) (can be true or false) (default: false), "Lists all the tasks if the value is true", "if it is true then all other fields will be ignored and all tasks will be returned"

    "object_type": "list", // (string) (required) (can be list or task) (default: None), "type of object on which the action is to be performed and will be returned", "task type is for the task to be performed on a task, list type is for the task to be performed on a list of tasks"

    "list_name": "list_name", // (string) (optional) (any) (default: My Tasks), "name of the list",

    "task_name": "task_name", // (string) (optional) (any) (default: My Task), "name of the task", "only needed for task type"

    "action": "insert", // (string) (required) (can be list, insert, remove, update, get) (default: None), "action to be performed", "list action is for listing all the tasks in a list, insert action is for inserting a new task or a new list, remove action is for removing a task or a list, update action is for updating a task or a list, get action is for getting a task or a list by its name"

    "max_results": 10, // (int) (optional) (any) (default: 10), "maximum number of tasks to be returned", "only needed for list action"

    "new_list_name": "new_list_name", // (string) (optional) (any) (default: New List), "new name of the list", "only needed for insert and update actions" "only needed for list type" "makes the list name field optional"

    "new_task_name": "new_task_name", // (string) (optional) (any) (default: New Task), "new name of the task", "only needed for insert and update actions" "only needed for task type" "makes the task name field optional"

    "due_date": "2024-11-01T00:00:00", // (string) (optional) (any) (default: None), "due date of the task", "only needed for insert and update actions" "only needed for task type" "if not provided, the task will not have a due date"

    "notes": "notes", // (string) (optional) (any) (default: None), "notes of the task", "only needed for insert and update actions" "only needed for task type" "if not provided, the task will not have notes"

    "parent_task_name": "parent_task_name", // (string) (optional) (any) (default: None), "name of the parent task", "only needed for insert and update actions" "only needed for task type" "if not provided, the task will be a parent task"

    "mark_as_done": false // (bool) (optional) (can be true or false) (default: false), "marks the task as done", "only needed for update action" "only needed for task type"
}
