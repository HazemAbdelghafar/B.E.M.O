{
    "test_cases": [
        {
            "name": "List All Tasks Initially (Should be Empty)",
            "input": {
                "list_all_tasks": true
            },
            "expected_output": {
                "error": "No tasks found"
            }
        },
        {
            "name": "Insert a New List",
            "input": {
                "object_type": "list",
                "action": "insert",
                "new_list_name": "Work"
            },
            "expected_output": {
                "id": "work_list_id",
                "name": "Work",
                "last_updated": "2025-02-17 14:00:00",
                "last_updated_relative": "Just Now"
            }
        },
        {
            "name": "Insert a Task into 'Work' List",
            "input": {
                "object_type": "task",
                "action": "insert",
                "list_name": "Work",
                "new_task_name": "Draft report",
                "due_date": "2025-03-01T12:00:00",
                "notes": "Report for Q1",
                "mark_as_done": false
            },
            "expected_output": {
                "id": "task_1_id",
                "name": "Draft report",
                "last_updated": "2025-02-17 14:02:00",
                "last_updated_relative": "Just Now"
            }
        },
        {
            "name": "List Tasks in 'Work' List",
            "input": {
                "object_type": "task",
                "action": "list",
                "list_name": "Work",
                "max_results": 10
            },
            "expected_output": [
                {
                    "id": "task_1_id",
                    "list_id": "work_list_id",
                    "name": "Draft Report",
                    "list_name": "Work",
                    "last_updated": "2025-02-17 15:59:45",
                    "due_date": "2025-03-01 02:00:00",
                    "completed_date": null,
                    "is_done": false,
                    "notes": "Report for Q1\n\nB.E.M.O",
                    "parent_id": null,
                    "last_updated_relative": "1 second ago",
                    "completed_date_relative": null,
                    "due_date_relative": "13 hours from now, 59 minutes from now",
                    "parent_title": null
                }
            ]
        },
        {
            "name": "Insert a Task Without Specifying a List",
            "input": {
                "object_type": "task",
                "action": "insert",
                "new_task_name": "Buy groceries"
            },
            "expected_output": {
                "id": "task_2_id",
                "name": "Buy Groceries",
                "last_updated": "2025-02-17 15:50:40",
                "last_updated_relative": "Just Now"
            }
        },
        {
            "name": "Update 'Draft report' Task to 'Finalize report' and Mark as Done",
            "input": {
                "object_type": "task",
                "action": "update",
                "list_name": "Work",
                "task_name": "Draft report",
                "new_task_name": "Finalize report",
                "mark_as_done": true
            },
            "expected_output": {
                "id": "task_1_id",
                "name": "Finalize Report",
                "last_updated": "2025-02-17 15:50:43",
                "last_updated_relative": "Just Now"
            }
        },
        {
            "name": "Remove 'Buy groceries' Task from 'My Tasks'",
            "input": {
                "object_type": "task",
                "action": "remove",
                "list_name": "My Tasks",
                "task_name": "Buy groceries"
            },
            "expected_output": {
                "success": true
            }
        },
        {
            "name": "Attempt to Get a Non-existent Task",
            "input": {
                "object_type": "task",
                "action": "get",
                "list_name": "Work",
                "task_name": "Non-existent Task"
            },
            "expected_output": {
                "error": "Task not found"
            }
        },
        {
            "name": "Remove 'Work' List",
            "input": {
                "object_type": "list",
                "action": "remove",
                "list_name": "Work"
            },
            "expected_output": {
                "success": true
            }
        },
        {
            "name": "Try Listing Tasks in Removed 'Work' List",
            "input": {
                "object_type": "task",
                "action": "list",
                "list_name": "Work"
            },
            "expected_output": {
                "error": "No tasks found"
            }
        }
    ]
}
