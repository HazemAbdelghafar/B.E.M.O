// This file contains the expected JSON format for the tasks that are to be performed by the communication module (tasks api)

{
    "other_data": "other_data", // other data that will not be used by the communication module (optional)

    "object_type": "draft", // type of object on which the action is to be performed (required) (draft, user, message, label)
    "action": "insert", // action to be performed (required) (create, delete, update, get, list, send, count) (send, create is only for draft type) (count is only for label type)

    "get_by": ["subject"], // get the object by (optional) (subjects, recipients, labels, senders, attachment_names, has_attachment, name) (Can be multiple) (only for delete, get, list, count, send, update actions) (label type has only name) (default: subject) (only for draft, message, label type) (subject, recipients only and only for draft update action) (senders only for message type)

    "get_by_values": ["subject_value"], // value of the get_by (optional) (only for delete, get, list, count, send, update actions) (default: None)

    "max_output": 10, // maximum number of objects to be returned (optional) (default: 10) (only for list action) (only for draft, message)
    "include_spam_trash": false, // includes spam and trash (optional) (default: false) (true, false) (only for list action) (only for draft, message, label type) (only for draft, message)
    "query": "query", // query to filter the objects (optional) (only for list action) (only for draft, message) (default: None)

    "all": false, // send or delete all objects (optional) (default: false) (true, false) (only for delete, send actions) (only for draft, label, message type) (if true, get_by_value will be ignored) (send only for draft type)

    "create_and_send": false, // create and send the draft (optional) (default: false) (true, false) (only for draft type) (only for create action)

    "count_by": "custom", // count the objects by (optional) (only for count action) (only for label type) (default: custom) (chat, sent, inbox, draft, spam, trash, important, starred, unread, custom)

    "new_label_names": ["new_label_name"], // new name of the label (optional) (only for update and create action) (only for label type)

    "new_parent_label_names": ["new_parent_label_name"], // new name of the parent label (optional) (only for update and create action) (only for label type)

    "new_background_color": "new_background_color", // new background color of the label (optional) (only for update and create action)

    "new_color_text": "new_color_text", // new text color of the label (optional) (only for update and create action) (only for label type)

    "new_draft_subjects": ["new_draft_subject"], // new subject of the draft (optional) (only for update and create action) (only for draft type)

    "new_draft_recipients": ["new_draft_recipient"], // new recipient of the draft (optional) (only for update and create action) (only for draft type)

    "new_draft_body": "new_draft_body", // new body of the draft (optional) (only for update and create action) (only for draft type)

    "new_draft_cc": ["new_draft_cc"], // new cc of the draft (optional) (only for update and create action) (only for draft type)

    "new_draft_bcc": ["new_draft_bcc"], // new bcc of the draft (optional) (only for update and create action) (only for draft type)

    "add_labels": ["label_name"], // add the label to the object (optional) (only for update and create action) (only for draft, message type)

    "remove_labels": ["label_name"] // remove the label from the object (optional) (only for update action) (only for draft, message type)
}
