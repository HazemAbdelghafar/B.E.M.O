// Define the ResNet for face recognition (same as before)
template <template <int, template<typename>class, int, typename> class block, int N, template<typename>class BN, typename SUBNET>
using residual = add_prev1<block<N, BN, 1, tag1<SUBNET>>>;

template <template <int, template<typename>class, int, typename> class block, int N, template<typename>class BN, typename SUBNET>
using residual_down = add_prev2<avg_pool<2, 2, 2, 2, skip1<tag2<block<N, BN, 2, tag1<SUBNET>>>>>>;

template <int N, template <typename> class BN, int stride, typename SUBNET>
using block = BN<con<N, 3, 3, 1, 1, relu<BN<con<N, 3, 3, stride, stride, SUBNET>>>>>;

template <int N, typename SUBNET> using ares = relu<residual<block, N, affine, SUBNET>>;
template <int N, typename SUBNET> using ares_down = relu<residual_down<block, N, affine, SUBNET>>;

template <typename SUBNET> using alevel0 = ares_down<256, SUBNET>;
template <typename SUBNET> using alevel1 = ares<256, ares<256, ares_down<256, SUBNET>>>;
template <typename SUBNET> using alevel2 = ares<128, ares<128, ares_down<128, SUBNET>>>;
template <typename SUBNET> using alevel3 = ares<64, ares<64, ares<64, ares_down<64, SUBNET>>>>;
template <typename SUBNET> using alevel4 = ares<32, ares<32, ares<32, SUBNET>>>;

using anet_type = loss_metric<fc_no_bias<128, avg_pool_everything<
                           alevel0<
                           alevel1<
                           alevel2<
                           alevel3<
                           alevel4<
                           max_pool<3, 3, 2, 2, relu<affine<con<32, 7, 7, 2, 2,
                           input_rgb_image_sized<150>
                           >>>>>>>>>>>>;

// Include headers and Dlib ResNet code as in previous script

int main(int argc, char** argv) try {
    if (argc < 2) {
        cerr << "Usage: " << argv[0] << " <image_path>" << "\n";
        return 1;
    }
    ios_base::sync_with_stdio(false); cin.tie(NULL); cout.tie(NULL);

    string image_path = argv[1];
    frontal_face_detector hog_detector = get_frontal_face_detector();
    shape_predictor sp;
    deserialize("../models/shape_predictor_68_face_landmarks.dat") >> sp;
    anet_type net;
    deserialize("../models/dlib_face_recognition_resnet_model_v1.dat") >> net;
    std::vector<matrix<float, 0, 1>> user_descriptors;
    deserialize("user_descriptors.dat") >> user_descriptors;

    cv::Mat temp = cv::imread(image_path);
    if (temp.empty()) {
        cerr << "Error: Unable to load image!" << "\n";
        return 1;
    }
    cv::resize(temp, temp, cv::Size(800, temp.rows * 800 / temp.cols));

    cv_image<bgr_pixel> cimg(temp);
    std::vector<dlib::rectangle> faces = hog_detector(cimg);

    for (const auto& face : faces) {
        auto shape = sp(cimg, face);
        matrix<rgb_pixel> face_chip;
        extract_image_chip(cimg, get_face_chip_details(shape, 150, 0.25), face_chip);
        matrix<float, 0, 1> face_descriptor = net(face_chip);

        bool is_user = false;
        for (const auto& user_descriptor : user_descriptors) {
            double distance = length(user_descriptor - face_descriptor);
            if (distance < 0.6) {
                is_user = true;
                break;
            }
        }
        if(is_user)
        cout<<"found user\n";
        else cout<<"not found\n";

        // cv::Rect cv_face(face.left(), face.top(), face.width(), face.height());
        // cv::Scalar color = is_user ? cv::Scalar(0, 255, 0) : cv::Scalar(0, 0, 255);
        // cv::rectangle(temp, cv_face, color, 2);
        // std::string label = is_user ? "User Recognized" : "Unknown";
        // cv::putText(temp, label, cv::Point(face.left(), face.top() - 10), cv::FONT_HERSHEY_SIMPLEX, 0.5, color, 2);
    }

    // cv::imshow("Face Recognition Result - HOG", temp);
    // cv::waitKey(0);
    // cv::destroyAllWindows();
    return 0;
}
catch (std::exception& e) {
    cout << "Exception: " << e.what() << "\n";
    return 1;
}

