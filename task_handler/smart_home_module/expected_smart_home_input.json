// This file contains the expected JSON format for the tasks that are to be performed by the smart home module

{
    "other_data": "other_data", // other data that will not be used by the smart home module (optional)

    "switch_number": ["switch_1", "switch_2"], // switch number (required) (switch_[all_numbers])
    "action": ["on", "off"] // action to be performed (required) (on/off)
}
