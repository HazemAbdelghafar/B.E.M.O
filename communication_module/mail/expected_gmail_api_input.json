{
    // This file contains the expected JSON format for the tasks to be performed by the Gmail communication module (Gmail API).
    // Optional fields are removed if not needed and will be interpreted as their default values.
    // Required fields cannot be removed and will result in an error response if not provided.
    // Not providing the specific values for the fields will result in an error response.
    // Syntax: "key": "example value" // (type) (optional or required) (possible values) (default value), "description", "notes" ...

    "other_data": "other_data", // (any) (optional) (any) (default: None), "other data that will not be used by the communication module",

    "object_type": "draft", // (string) (required) (can be draft, user, message, label) (default: None), "type of object on which the action is to be performed",

    "action": "insert", // (string) (required) (can be create, delete, update, get, list, send, count) (default: None), "action to be performed",

    "get_by": ["subject"], // (array) (optional) (can be subject, recipients, labels, senders, attachment_names, has_attachment, name) (default: ["subject"]), "filter objects by specific attribute",

    "get_by_values": ["subject_value"], // (array) (optional) (any) (default: None), "values for filtering objects by get_by attribute",

    "max_output": 10, // (int) (optional) (any) (default: 10), "maximum number of objects to be returned",

    "include_spam_trash": false, // (bool) (optional) (can be true or false) (default: false), "includes spam and trash in list action",

    "query": "query", // (string) (optional) (any) (default: None), "query to filter the objects",

    "all": false, // (bool) (optional) (can be true or false) (default: false), "send or delete all objects if true, ignoring get_by_values",

    "create_and_send": false, // (bool) (optional) (can be true or false) (default: false), "create and send the draft immediately after creation",

    "count_by": "custom", // (string) (optional) (can be custom, chat, sent, inbox, draft, spam, trash, important, starred, unread) (default: custom), "count objects by a specific category",

    "new_label_names": ["new_label_name"], // (array) (optional) (any) (default: None), "new names for the label",

    "new_parent_label_names": ["new_parent_label_name"], // (array) (optional) (any) (default: None), "new parent label names",

    "new_background_color": "new_background_color", // (string) (optional) (any) (default: None), "new background color for the label",

    "new_color_text": "new_color_text", // (string) (optional) (any) (default: None), "new text color for the label",

    "new_draft_subjects": ["new_draft_subject"], // (array) (optional) (any) (default: None), "new subject for the draft",

    "new_draft_recipients": ["new_draft_recipient"], // (array) (optional) (any) (default: None), "new recipient(s) for the draft",

    "new_draft_body": "new_draft_body", // (string) (optional) (any) (default: None), "new body for the draft",

    "new_draft_cc": ["new_draft_cc"], // (array) (optional) (any) (default: None), "new cc recipients for the draft",

    "new_draft_bcc": ["new_draft_bcc"], // (array) (optional) (any) (default: None), "new bcc recipients for the draft",

    "add_labels": ["label_name"], // (array) (optional) (any) (default: None), "labels to be added to the object",

    "remove_labels": ["label_name"] // (array) (optional) (any) (default: None), "labels to be removed from the object"
}
